# Discord Developer Portal で取得
DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id

# VOICEVOX Engine の URL (docker compose 既定)
VOICEVOX_URL=http://localhost:50021

# 任意: コマンドを即時登録するギルド (カンマ区切りで複数。空ならグローバル登録)
GUILD_IDS=

# 任意: 自動参加時の読み上げ対象ch。guildId:channelId をカンマ区切り (未指定のギルドは全ch)
READ_CHANNELS=

# 任意: /dict word (全サーバー共通の VOICEVOX ユーザー辞書) を操作・閲覧できるユーザーID。
# カンマ区切り。未設定なら Bot 所有者 (Team 所有ならそのメンバー) だけが使える。
OPERATOR_IDS=

# 任意: Fish Audio (https://fish.audio) の TTS を使う場合のみ設定。
# 未設定なら Fish は無効化され、従来どおり VOICEVOX のみで動作する。
# キーは https://fish.audio/app/api-keys/ で発行。
FISH_API_KEY=
# s2.1-pro-free は 2026-08-31 まで無料 (SLAなし・リクエストがモデル改善に使われる)。
# 期限後や本番運用では s2.1-pro / s2-pro / s1 に切り替える ($15 / 1M UTF-8 bytes)。
FISH_MODEL=s2.1-pro-free
