# Discord Developer Portal で取得
DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id

# VOICEVOX Engine の URL (docker compose 既定)
VOICEVOX_URL=http://localhost:50021

# 任意: コマンドを即時登録するギルド (カンマ区切りで複数。空ならグローバル登録)
GUILD_IDS=

# 任意: 自動参加時の読み上げ対象ch。guildId:channelId をカンマ区切り (未指定のギルドは全ch)
READ_CHANNELS=
